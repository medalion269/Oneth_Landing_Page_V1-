# oneth landing page: form submission backend
# Leave everything empty to run in development mode.
# In development mode the form validates and responds, but nothing is stored,
# and the page tells the visitor so.

# Option A: Supabase (server-side insert through the REST API)
# Use the service role key. It is only read on the server, never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PILOT_TABLE=pilot_applications
SUPABASE_WAITLIST_TABLE=waitlist

# Option B: any HTTPS endpoint that accepts a JSON POST
# (your own API, a CRM webhook, a form service). Used only if Supabase is not set.
SUBMISSION_ENDPOINT=
# Optional bearer token sent as "Authorization: Bearer <token>"
SUBMISSION_ENDPOINT_TOKEN=

# Where the oneth app (../frontend) is served. The "Sign in" links go to <this URL>/login.
# Leave empty to hide them in a production build. In development they default to http://localhost:5173.
NEXT_PUBLIC_APP_URL=
