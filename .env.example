# oneth landing page: form submission backend
# Leave everything empty to run in development mode.
# In development mode the form validates and responds, but nothing is stored,
# and the page tells the visitor so.

# Option A: Supabase (server-side insert through the REST API)
# Use the service role key. It is only read on the server, never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PILOT_TABLE=pilot_applications
SUPABASE_WAITLIST_TABLE=waitlist

# Option B: any HTTPS endpoint that accepts a JSON POST
# (your own API, a CRM webhook, a form service). Used only if Supabase is not set.
SUBMISSION_ENDPOINT=
# Optional bearer token sent as "Authorization: Bearer <token>"
SUBMISSION_ENDPOINT_TOKEN=

# Option C: an email per submission through Resend (resend.com). Used only if A and B are not set.
# Create the key with "Sending access". Replies to the email go to the visitor.
RESEND_API_KEY=
# Who receives the emails (comma-separated for several). Until a domain is verified in Resend,
# this must be the address the Resend account was created with, or every send fails.
RESEND_TO=
# Optional. Defaults to Resend's test sender, "oneth <onboarding@resend.dev>".
# Once oneth.ai is verified in Resend, use an address on it, e.g. "oneth <pilot@oneth.ai>".
RESEND_FROM=

# Where the oneth app (../frontend) is served. The "Sign in" links go to <this URL>/login.
# Leave empty to hide them in a production build. In development they default to http://localhost:5173.
NEXT_PUBLIC_APP_URL=

# Microsoft Clarity (heatmaps and session recordings). The project ID from clarity.microsoft.com,
# Settings > Overview. Leave empty to load nothing. In Vercel set it for Production only, so
# previews are not recorded. It is read at build time: redeploy after changing it.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
